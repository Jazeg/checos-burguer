{
  "name": "Checo’s Burger · carta digital",
  "image": "mcr.microsoft.com/devcontainers/python:3",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "forwardPorts": [8093],
  "portsAttributes": {
    "8093": { "label": "Carta", "onAutoForward": "openPreview" }
  },
  "postAttachCommand": "nohup python3 -m http.server 8093 --bind 0.0.0.0 > /tmp/server.log 2>&1 &"
}
